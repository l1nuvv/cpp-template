* text=auto

# C/C++
*.c     text diff=cpp eol=lf
*.cc    text diff=cpp eol=lf
*.cpp   text diff=cpp eol=lf
*.cxx   text diff=cpp eol=lf
*.h     text diff=cpp eol=lf
*.hh    text diff=cpp eol=lf
*.hpp   text diff=cpp eol=lf
*.hxx   text diff=cpp eol=lf
*.inl   text diff=cpp eol=lf
*.ipp   text diff=cpp eol=lf
*.tpp   text diff=cpp eol=lf

# CMake and configuration
CMakeLists.txt text eol=lf
*.cmake        text eol=lf
*.json         text eol=lf
*.jsonc        text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.toml         text eol=lf
*.ini          text eol=lf

# Documentation and repository configuration
*.md           text eol=lf
*.txt          text eol=lf
.editorconfig  text eol=lf
.clang-format  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Scripts
*.sh  text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.zip  binary
*.7z   binary
*.rar  binary
*.exe  binary
*.dll  binary
*.lib  binary
*.a    binary
*.o    binary
*.obj  binary
*.pdb  binary
