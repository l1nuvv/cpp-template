{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "msvc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "msvc-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CMake: configure"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: build release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "msvc-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "CMake: configure"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: clean debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "msvc-debug",
        "--target",
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
